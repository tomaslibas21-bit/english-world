{"story_id":"TOM-001","duration_seconds":40.25454166666667,"timeline":[{"sentence_id":"TOM-001-S001","language":"lt","text":"Tomas nusiveda Reičelę į kavinę pietų.","start":0.0,"end":3.4326666666666665},{"sentence_id":"TOM-001-S001","language":"en","text":"Tom takes Rachel to a café for lunch.","start":3.732666666666667,"end":7.840458333333333},{"sentence_id":"TOM-001-S002","language":"lt","text":"„Čia gera sriuba“, – sako jis.","start":8.373791666666667,"end":10.606541666666667},{"sentence_id":"TOM-001-S002","language":"en","text":"“The soup is good here,” he says.","start":10.906541666666667,"end":13.629541666666666},{"sentence_id":"TOM-001-S003","language":"lt","text":"Jis dar niekada čia nebuvo.","start":14.162875,"end":16.597708333333333},{"sentence_id":"TOM-001-S003","language":"en","text":"He has never been here before.","start":16.897708333333334,"end":19.0665},{"sentence_id":"TOM-001-S004","language":"lt","text":"„Imsiu dubenį tos raudonos sriubos“, – sako jis.","start":19.599833333333333,"end":23.354708333333335},{"sentence_id":"TOM-001-S004","language":"en","text":"“I'll have a bowl of that red soup,” he says.","start":23.654708333333332,"end":27.105375},{"sentence_id":"TOM-001-S005","language":"lt","text":"„Ir šiek tiek negazuoto vandens, prašau.“","start":27.638708333333334,"end":30.435708333333334},{"sentence_id":"TOM-001-S005","language":"en","text":"“And some still water, please.”","start":30.735708333333335,"end":32.963458333333335},{"sentence_id":"TOM-001-S006","language":"lt","text":"„Ji gana aštri“, – sako padavėja.","start":33.49679166666667,"end":36.494875},{"sentence_id":"TOM-001-S006","language":"en","text":"“It's quite spicy,” the server says.","start":36.794875,"end":40.25454166666667}],"rate_switches":{"version":1,"audio_sha256":"df98be040ebc0c1c622f4fe9182de3a87910305d320448a95d79b7bdb80a61de","speech":[[0.31,3.11],[4.132,7.783],[8.393,10.424],[10.996,13.577],[14.422,16.313],[16.927,18.978],[19.929,23.11],[23.744,27.045],[27.898,30.179],[30.815,32.936],[33.616,36.237],[36.884,40.185]],"sw":[0,3.621,8.088,10.71,14.0,16.62,19.453,23.427,27.471,30.497,33.276,36.561]},"audio_sha256":{"bilingual":"df98be040ebc0c1c622f4fe9182de3a87910305d320448a95d79b7bdb80a61de","english":"6f3aed94a085fe3e9f70796023c7ce92c29da7465e625379e134842dce78d808"}}
