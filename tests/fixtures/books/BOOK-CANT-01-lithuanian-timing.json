{"story_id":"BOOK-CANT-01","mode":"lithuanian","duration_seconds":29.0715,"pause_seconds":0.55,"source":{"bilingual_sha256":"c83184f0ea4e3e3a1e87f4e9d7c7dd680e5655c73e06ae23a0c1a15e5d516135","made_by":"make_lithuanian_only.py"},"timeline":[{"sentence_id":"BOOK-CANT-01-S001","language":"lt","text":"Ponas Otisas norėjo nusipirkti seną namą Anglijoje.","start":0.0,"end":4.6691666666666665},{"sentence_id":"BOOK-CANT-01-S002","language":"lt","text":"Jis buvo Amerikos diplomatas ir mėgo priimti praktiškus sprendimus.","start":5.219166666666666,"end":10.49125},{"sentence_id":"BOOK-CANT-01-S003","language":"lt","text":"Namas vadinosi Kentervilio dvaru.","start":11.04125,"end":14.036125},{"sentence_id":"BOOK-CANT-01-S004","language":"lt","text":"Jame buvo gražūs kambariai, didelis sodas ir vaiduoklis.","start":14.586125,"end":20.101166666666668},{"sentence_id":"BOOK-CANT-01-S005","language":"lt","text":"Lordas Kentervilis manė, kad pirkėjas turėtų žinoti apie vaiduoklį.","start":20.651166666666665,"end":25.286125},{"sentence_id":"BOOK-CANT-01-S006","language":"lt","text":"„Mes ten nebegyvename, – paaiškino jis. –","start":25.836125,"end":29.0715}],"audio_sha256":{"lithuanian":"b6be4a2a6a8b96bb808f89c80165994dd0a5ef744fb10c5dd426ee989f30ed9a"}}
