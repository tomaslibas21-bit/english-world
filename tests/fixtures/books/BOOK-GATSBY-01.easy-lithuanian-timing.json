{"story_id":"BOOK-GATSBY-01","mode":"lithuanian","duration_seconds":31.242708333333333,"pause_seconds":0.55,"source":{"bilingual_sha256":"9cd3e78529ac63e26ff351596160de26f5218362ded785f77e910bbd09e1568b","made_by":"make_lithuanian_only.py"},"timeline":[{"sentence_id":"BOOK-GATSBY-01-S001","language":"lt","start":0.0,"end":5.955958333333333,"text":"Kai buvau jaunesnis ir lengviau pažeidžiamas, tėvas davė man vieną patarimą."},{"sentence_id":"BOOK-GATSBY-01-S002","language":"lt","start":6.505958333333333,"end":8.982625,"text":"Nuo tada vis jį apmąstau."},{"sentence_id":"BOOK-GATSBY-01-S003","language":"lt","start":9.532625,"end":19.809041666666666,"text":"„Kai tik užsimanysi ką nors kritikuoti, – pasakė jis man, – atsimink, kad ne visi šiame pasaulyje turėjo tokių privalumų, kokių turėjai tu.“"},{"sentence_id":"BOOK-GATSBY-01-S004","language":"lt","start":20.359041666666666,"end":22.629083333333334,"text":"Daugiau jis nieko nepasakė."},{"sentence_id":"BOOK-GATSBY-01-S005","language":"lt","start":23.179083333333335,"end":27.094875,"text":"Bet mudu visada gerai supratome vienas kitą be daug žodžių."},{"sentence_id":"BOOK-GATSBY-01-S006","language":"lt","start":27.644875,"end":31.242708333333333,"text":"Supratau, kad jis turėjo omenyje kur kas daugiau."}]}
