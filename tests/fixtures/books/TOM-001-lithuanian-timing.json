{"story_id":"TOM-001","mode":"lithuanian","duration_seconds":20.40020833333333,"pause_seconds":0.55,"source":{"bilingual_sha256":"5ad9c0a90c5f0b4c633c4a9f2f20be643bcecfbb5f3b05f991f09f0ce614dab7","made_by":"make_lithuanian_only.py"},"timeline":[{"sentence_id":"TOM-001-S001","language":"lt","text":"Tomas nusiveda Reičelę į kavinę pietų.","start":0.0,"end":3.4326666666666665},{"sentence_id":"TOM-001-S002","language":"lt","text":"„Čia gera sriuba“, – sako jis.","start":3.982666666666667,"end":6.215416666666667},{"sentence_id":"TOM-001-S003","language":"lt","text":"Jis dar niekada čia nebuvo.","start":6.765416666666667,"end":9.20025},{"sentence_id":"TOM-001-S004","language":"lt","text":"„Imsiu dubenį tos raudonos sriubos“, – sako jis.","start":9.75025,"end":13.505125},{"sentence_id":"TOM-001-S005","language":"lt","text":"„Ir šiek tiek negazuoto vandens, prašau.“","start":14.055125,"end":16.852125},{"sentence_id":"TOM-001-S006","language":"lt","text":"„Ji gana aštri“, – sako padavėja.","start":17.402125,"end":20.40020833333333}],"audio_sha256":{"lithuanian":"621478d16aeea21be96c64b1f084fe5339a519be82e1c0dd63fe8d51b8001130"}}
