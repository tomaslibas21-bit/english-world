{"story_id":"BOOK-CANT-01","duration_seconds":61.563208333333336,"timeline":[{"sentence_id":"BOOK-CANT-01-S001","language":"lt","text":"Ponas Otisas norėjo nusipirkti seną namą Anglijoje.","start":0.0,"end":4.6691666666666665},{"sentence_id":"BOOK-CANT-01-S001","language":"en","text":"Mr. Otis wanted to buy an old house in England.","start":4.969166666666666,"end":9.970333333333333},{"sentence_id":"BOOK-CANT-01-S002","language":"lt","text":"Jis buvo Amerikos diplomatas ir mėgo priimti praktiškus sprendimus.","start":10.503666666666666,"end":15.775749999999999},{"sentence_id":"BOOK-CANT-01-S002","language":"en","text":"He was an American diplomat, and he liked to make practical decisions.","start":16.07575,"end":22.296458333333334},{"sentence_id":"BOOK-CANT-01-S003","language":"lt","text":"Namas vadinosi Kentervilio dvaru.","start":22.829791666666665,"end":25.824666666666666},{"sentence_id":"BOOK-CANT-01-S003","language":"en","text":"The house was called Canterville Chase.","start":26.124666666666666,"end":29.569583333333334},{"sentence_id":"BOOK-CANT-01-S004","language":"lt","text":"Jame buvo gražūs kambariai, didelis sodas ir vaiduoklis.","start":30.102916666666665,"end":35.617958333333334},{"sentence_id":"BOOK-CANT-01-S004","language":"en","text":"It had fine rooms, a large garden, and a ghost.","start":35.91795833333333,"end":42.56670833333333},{"sentence_id":"BOOK-CANT-01-S005","language":"lt","text":"Lordas Kentervilis manė, kad pirkėjas turėtų žinoti apie vaiduoklį.","start":43.10004166666666,"end":47.735},{"sentence_id":"BOOK-CANT-01-S005","language":"en","text":"Lord Canterville thought that the buyer ought to know about the ghost.","start":48.035,"end":53.29754166666666},{"sentence_id":"BOOK-CANT-01-S006","language":"lt","text":"„Mes ten nebegyvename, – paaiškino jis. –","start":53.830875,"end":57.06625},{"sentence_id":"BOOK-CANT-01-S006","language":"en","text":"“We do not live there anymore,” he explained.","start":57.36625,"end":61.563208333333336}],"audio_sha256":{"bilingual":"9d93ccd28301b2b960886a3754937f1bb6cd5820c9230987d74f35367d1e6852","english":"2c8e316423659694da67e0eaa15949a5b4143b7de0737d9dc4653d592d5def18"},"rate_switches":{"version":1,"audio_sha256":"9d93ccd28301b2b960886a3754937f1bb6cd5820c9230987d74f35367d1e6852","speech":[[0.22,4.38],[5.289,9.62],[10.513,15.544],[16.175,22.046],[23.079,25.57],[26.134,29.545],[30.332,35.343],[36.317,42.318],[43.21,47.411],[48.264,52.915],[54.14,56.851],[57.696,61.407]],"sw":[0,4.835,10.066,15.86,22.562,25.852,29.939,35.83,42.764,47.838,53.528,57.273]}}
