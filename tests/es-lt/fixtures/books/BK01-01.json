  "data": {
    "id": "BK01-01",
    "title_es": "La tortuga gigante",
    "title_lt": "Milžiniškas vėžlys",
    "paragraphs": [
      {
        "lt": "Orasijus Kiroga – rašytojas iš Urugvajaus. Daug metų jis gyveno Argentinos džiunglėse ir rašė pasakas savo vaikams. „Milžiniškas vėžlys“ – pirmoji knygos pasaka: paprasta ir graži istorija apie žmogų ir gyvūną, kurie padeda vienas kitam.",
        "sentences": [
          {
            "es": "Horacio Quiroga es un escritor de Uruguay.",
            "lt": "Orasijus Kiroga – rašytojas iš Urugvajaus.",
            "units": [
              ["Horacio","Orasijus (tariama „orásjo“)",""],
              ["Quiroga","Kiroga (tariama „kiróga“)",""],
