              ["vivía","gyveno",""],
              ["en Buenos Aires.","Buenos Airėse.",""]
            ],
            "n": 3,
            "en": "Había una vez un hombre que vivía en Buenos Aires.",
            "sentence_id": "001"
          },
          {
            "i": 1,
            "es": "Era sano y trabajador, y estaba muy contento.",
            "lt": "Jis buvo sveikas, darbštus ir labai laimingas.",
            "units": [
              ["Era","Buvo",""],
              ["sano","sveikas",""],
              ["y","ir",""],
              ["trabajador,","darbštus,",""],
              ["y","ir",""],
