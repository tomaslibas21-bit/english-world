        "sentence_id": "BK01-00-004",
        "start": 33.4,
        "end": 43.32
      },
      {
        "item_id": "BK01-00",
        "sentence": "005",
        "language": "lt",
        "text": "Šiandien ją skaito visos Lotynų Amerikos mokyklose.",
        "sentence_id": "BK01-00-005",
        "start": 43.82,
        "end": 47.62
      },
      {
        "item_id": "BK01-00",
        "sentence": "006",
        "language": "lt",
        "text": "Trumpi sakiniai, aiškūs vaizdai ir šiltas humoras padaro skaitymą lengvą ir malonų.",
        "sentence_id": "BK01-00-006",
        "start": 48.12,
        "end": 54.4
      },
      {
        "item_id": "BK01-00",
        "sentence": "007",
        "language": "lt",
        "text": "Kartą gyveno Buenos Airėse vienas žmogus, ir jis buvo labai laimingas, nes buvo sveikas ir darbštus.",
        "sentence_id": "BK01-00-007",
        "start": 54.9,
        "end": 62.9
      },
      {
        "item_id": "BK01-00",
        "sentence": "008",
        "language": "lt",
        "text": "Bet vieną dieną jis susirgo, ir gydytojai jam pasakė, kad pasveikti jis galės tik išvažiavęs gyventi į kaimą.",
        "sentence_id": "BK01-00-008",
        "start": 63.4,
        "end": 72.4
      }
    ]
  },
