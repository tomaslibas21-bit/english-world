ast":[["jessie","es_jessie",1]],"translationsLt":["Sveiki! Užeikite!","Ar Jūs mano 15 val. klientas?","Vardu Ryan.","Viskas! Jus jau užrašiau.","Ką Jums šiandien darysime?","Noriu naujo įvaizdžio.","Oi, naujas įvaizdis! Labai patinka.","Kiek nukirpti?","Du centimetrus, prašau.","Gerai, 2 cm.","Mašinėle ar žirklėmis?","Žirklėmis, prašau.","Gerai, žirklėmis.","Gal pirma išplauti plaukus?","Taip, prašau.","Pradėkime prie kriauklės.","Vanduo tinka?","Puikus, ačiū.","A, puiku!","Mano katė šįryt numetė mano kavą nuo stalo!","Kaip juokinga!","Taip, su ja daug vargo!","O ką veiksite šį savaitgalį?","Nieko ypatingo. Ilsėsiuosi.","Pailsėti? Tai irgi puiku!","Ar norite, kad išdžiovinčiau plaukus?","Tiesius, prašau.","Būtinai!","Na, baigta! Kaip patinka?","Man labai patinka!","Valio! Labai džiaugiuosi!","Su plovimu ir džiovinimu – 300 pesų.","Kortele, prašau.","Priglauskite kortelę čia. Terminalas paklaus apie arbatpinigius.","Dešimt procentų, prašau.","Kaip miela! Labai ačiū!","Užrašyti Jus kitam vizitui?","Kol kas ne, ačiū.","Jokių problemų. Tiesiog parašykite man žinutę.","Ačiū, kad užsukote!","Gero savaitgalio!","Sveiki, laba diena! Kaip laikotės?","Puikiai, ačiū, kad paklausėte!","Puiku!","Ar esate užsirašęs?","Mano vardas – Ryan.","Na, ką šiandien darysime?","Tik galiukus.","Gerai, tik galiukus.","Patrumpinti ir kirpčiukus?","Ne, man ir taip gerai, ačiū.","Gerai.","Ne, ačiū.","Jokių problemų, tik truputį sudrėkinsiu.","Mano katė kas naktį miega man ant galvos!","Ar ne?","Ar turite augintinių?","Turiu katę.","Kačių mylėtojas! Taip ir žinojau!","Oi… Rodos, nukirpau truputėlį daugiau, nei sutarėme.","Nieko tokio. Ataugs.","Ačiū, kad esate toks supratingas.","Nuleisiu Jums 50 pesų.","Bus 150 pesų.","Paliksiu dešimt procentų.","Oi, labai ačiū!","Kaip mokėsite?","Prašom.","O štai Jūsų grąža.","Tegul džiugina naujas įvaizdis!","Iki kito karto!","Kaip malonu Jus vėl matyti!","Puiku, matau Jus sąraše.","Norėčiau nusikirpti plaukus.","Žinoma! O ką turite omenyje?","Palikti sluoksniuotą kirpimą?","Žinoma, ačiū!","Aišku.","O iš kur Jūs?","Esu iš JAV.","A, šaunu! Aš ten niekada nebuvau.","Baigta! Pažiūrėkite. Kaip Jums?","Oi, koks Jūs mielas!","Iš viso 200 pesų.","Ar galiu sumokėti pavedimu?","Štai mano rekvizitai pavedimui.","Puiku, pinigai atėjo!","Būtų puiku, ačiū!","Puiku! Po šešių savaičių tuo pačiu laiku?","Ačiū už pagalbą!","Nėra už ką!","Viso gero!","Iki! Sėkmės!","Turiu šunį.","Jums pasisekė! Kaip tik dabar turiu laisvo laiko.","Oi, aš dievinu šunis!","Gal galite nukirpti kaip šioje nuotraukoje?","Oi, kaip gražu! Tikrai galiu taip padaryti.","Išdžiovinti plaukus?","Mielai!","Jums labai tinka!","Bus 250 pesų.","Taip, po šešių savaičių.","Viskas, užrašiau!","Ne per trumpai, prašau.","Nesijaudinkite, daug nenukirpsiu.","O kiek trumpinsime?","Puiku, pradėkime nuo plovimo.","Ar vanduo tinkamos temperatūros?","Puiku!","Mano katė išmoko atidaryti šaldytuvą!","Iš viso 250 pesų.","Ar galiu mokėti kortele?","Ačiū!","Ar galiu užsirašyti kitam vizitui?","Sveiki atvykę į kirpyklą „Tijeras“!","Esu užsirašęs 15 val.","Gerai. Gal galite pasakyti vardą?","Tik patrumpinti galiukus, prašau.","Nesudėtinga!","Bus 200 pesų.","Grąžos nereikia!","Smagu girdėti!","Žinoma.","Iš viso 150 pesų.","Kiek Jums mokėti?","Ar priimate korteles?","Puiku, ačiū!","Nėra už ką!","Geros dienos!","Viso gero! Geros dienos!","Žinoma, tik patrumpinti galiukus.","Gerai, tegul išdžiūsta natūraliai.","Puiku! Koks vardas?","Ar galiu palikti arbatpinigių?","Malonu girdėti!","Mokėsiu grynaisiais.","Mielai!","Laikykitės!","Visada prašom!","Iki pasimatymo!","Čia Jums.","Penkiolika procentų – tinka.","Esu iš Kanados."],"turns":[[0,"¡Hola, buenas! ¡Pásele!","Hi there! Come on in!","b5a2909a8a2c",1.99],[0,"¿Usted es mi cita de las tres?","Are you my three o'clock?","3947bb8b40bc",1.47],[-1,"A nombre de Ryan.","It's under Ryan.",1],[0,"¡Listo! Ya lo tengo anotado.","All set! I've got you down.","d77f9d65f958",1.79],[0,"¿Qué le hacemos hoy?","What can I do for you today?","7365f2e85072",0.82],