","Čia kiekvieną smūgį reikia paskelbti: kamuolį ir kišenę.","Štai taip: „Septintas – į kampinę kišenę.“","Įmuškite savo keturis kamuolius, o tada – aštuntąjį.","Vienspalviai ar dryžuoti?","Imsiu dryžuotus.","Gerai, Jūs žaidžiate dryžuotais.","Vienspalvius, prašau.","Aišku.","Ar žaidžiate kasdien?","Kiekvieną vakarą. Kartais iki vėlyvos nakties!","Pirmyn – Jūs pradedate. Sėkmės!","O, Jūs vėl čia! Sužaidžiam partiją?","Gerai, Jūs žaidžiate vienspalviais.","Nuo kada žaidžiate?","Nuo vaikystės. Šį barą turėjo mano tėtis.","Supratau.","Taip, prašau.","Gerai.","Ne, man ir taip gerai, ačiū.","Būtų puiku, ačiū!","Gana gerai, ačiū!","Žinoma, ačiū!","Labai ačiū!","Ačiū už pagalbą!","Ne, ačiū."],"turns":[[0,"¡Buenas! ¡Bienvenida a La Buchaca! ¿Juega billar?","Hi! Welcome to La Buchaca! Do you play pool?","960e7cabce71",3.3],[-1,"Un poquito.","A little.",1],[0,"¡Órale! Entonces echamos una partida.","All right! Then let's play a game.","dda360445b82",2.95],[0,"Yo soy Memo, el dueño. ¿Y usted, cómo se llama?","I'm Memo, the owner. And what's your name?","1b1c48a6a881",3.23],[-1,"Me llamo Ryan.","My name is Ryan.",1],[0,"Mucho gusto.","Nice to meet you.","71d8ad8547fe",1.03],[0,"Aquí se canta cada tiro: la bola y la buchaca.","Here you call every shot: the ball and the pocket.","f17619c9bea6",4.03],[0,"Así: la siete, a la buchaca de la esquina.","Like this: seven ball, corner pocket.","9b8975deb805",3.37],[0,"Meta sus cuatro bolas y luego la ocho.","Sink your four balls, then the eight ball.","afbfc98d2f8e",3.43],[0,"¿Lisas o rayadas?","Solids or stripes?","86fba33b85f0",1.92],[-1,"Yo quiero las rayadas.","I'll take stripes.",1],[0,"Muy bien, usted lleva las rayadas.","All right, you're stripes.","28e981544b50",2.82],[-1,"Las lisas, por favor.","Solids, please.",1],[0,"Ya veo.","I see.","7997c35595f3",1.22],[-1,"¿Juega todos los días?","Do you play every day?",1],[0,"Todas las noches. ¡A veces hasta muy tarde!","Every night. Sometimes till very late!","747d1b47e9c3",3.07],[0,"Ándele, usted rompe. ¡Suerte!","Go on, you break. Good luck!","bbf0e91a2caa",3.53],[0,"¡Otra vez por aquí! ¿Una partida?","Back again! Up for a game?","3b37bf1e340a",2.75],[0,"Muy bien, usted lleva las lisas.","All right, you're solids.","2edf7f1b9f96",2.65],[-1,"¿Desde cuándo juega?","How long have you played?",1],[0,"Desde chavo. Mi papá tenía esta cantina.","Since I was a kid. My dad had this cantina.","1929c6f18414",2.86],[0,"Entendido.","Got it.","ace03dd3d5a6",1.16],[-1,"Sí, por favor.","Yes, please.",1],[0,"Muy bien.","Okay.","df569f32a28c",0.72],[-1,"No, así estoy bien, gracias.","No, I'm good, thanks.",1],[-1,"¡Sería genial, gracias!","That would be great, thanks!",1],[-1,"Bastante bien, gracias.","Pretty good, thanks!",1],[-1,"¡Claro, gracias!","Sure, thanks!",1],[-1,"¡Muchas gracias!","Thank you very much!",1],[-1,"¡Gracias por su ayuda!","Thanks for your help!",1],[-1,"No, gracias.","No, thanks.",1]],"contexts":[{"sim":1,"visits":0,"seed":2},{"visits":1,"seed":1},{"visits":1,"seed":2},{"visits":0,"seed":1},{"visits":0,"seed":2}],"replies":["play/0","name/0","group/1","group/0","ask/1","ask/0","g_yesno/0","g_yesno/3","g_yesno/4","g_howareyou/2","g_yesno/2","g_social/0","g_social/1","g_yesno/1"],"paths":[[0,0,1,2,3,4],[1,0,1,3,5],[0,0,1,2,3,6],[0,0,1,2,3,7],[2,0,1,2,8],[1,0,1,3,9],[2,0,1,2,10],[3,0,1,3,11],[3,0,1,2,12],[1,0,1,3,13],[1,0,1,2,5],[1,0,1,2,7],[3,0,1,2,6],[3,0,1,2,11],[1,0,1,2,12],[1,0,1,2,11],[0,0,1,2,3,13],[0,0,1,2,3,11],[3,0,1,3,7],[0,0,1,2,3,12],[1,0,1,3,6],[3,0,1,2,7],[3,0,1,3,5],[2,0,1,3,10],[1,0,1,3,11],[0,0,1,2,3,5],[4,0,1,2,10],[1,0,1,2,4],[3,0,1,3,12],[1,0,1,2,13],[3,0,1,2,13],[3,0,1,2,5],[1,0,1,3,7],[3,0,1,3,13],[2,0,1,3,8],[4,0,1,2,8]]}
