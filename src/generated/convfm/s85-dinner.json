37,38,39],"cast":[["dan","g_dan",1],["nora","g_nora",1]],"turns":[[0,"Hi! So glad you could make it! Come on in!","Labas! Taip džiaugiuosi, kad galėjai atvykti! Užeik!","e5686fb2372b",3],[1,"Hi! Welcome!","Labas! Sveika atvykusi!","e82861991ece",1.71],[-2,"I brought you some chocolates.","Atnešiau jums saldainių.",1],[1,"Chocolates! Oh, you're too kind.","Saldainiai! O, tu per maloni.","e621c91641cc",2.71],[0,"Here, let me take your coat.","Še, leisk paimti tavo paltą.","5a04db99e5bb",1.46],[-1,"I brought you some wine.","Atnešiau jums vyno.",1],[1,"Thank you again!","Dar kartą ačiū!","76569a1ae6ec",1.24],[0,"What can I get you to drink?","Ką tau paduoti atsigerti?","1723eed3f31e",1.24],[-1,"Some juice, please.","Sulčių, prašau.",1],[0,"Sure thing!","Žinoma!","2edbf5e58359",0.85],[0,"Oh, and this is Mittens. Are you allergic to cats?","O, čia Mitens. Ar tau nėra alergijos katėms?","6c2cb7f699b2",3.37],[-1,"No, I love cats!","Ne, dievinu kates!",1],[0,"Good! She loves guests.","Gerai! Ji dievina svečius.","8a96d59f71e1",2.18],[1,"Dinner will be ready in five minutes!","Vakarienė bus po penkių minučių!","59998ca5dcd8",2.03],[-2,"You have a lovely home!","Jūsų namai nuostabūs!",1],[1,"Aw, thank you! We just painted the living room.","Oi, ačiū! Ką tik nudažėme svetainę.","9dbfd160ce45",2.81],[0,"Dinner is served! Please, help yourself!","Vakarienė patiekta! Prašom, vaišinkis!","0f45d312c7c1",2.87],[-1,"Could you pass the salt, please?","Ar galėtum paduoti druską?",1],[0,"Sure, here you go.","Žinoma, prašom.","cbc0faebedd1",1.33],[0,"How's the lasagna?","Na, kaip lazanija?","4d7d2c78b1a6",1.24],[-1,"You're a great cook!","Tu puikus virėjas!",1],[0,"Thank you! Have some more!","Ačiū! Imk daugiau!","b1198a7fa19b",2.07],[1,"Who's ready for dessert? I made chocolate cake!","Kas nori deserto? Iškepiau šokoladinį tortą!","e6c925a2663f",2.96],[-2,"A small piece, please.","Mažą gabalėlį, prašau.",1],[1,"A small piece, coming up!","Mažas gabalėlis – tuoj bus!","2242813904ca",1.71],[0,"Wow, where did the time go?","Oho, kaip greitai prabėgo laikas!","f9d0eacb9bdc",1.83],[-1,"Thank you for a lovely evening!","Ačiū už nuostabų vakarą!",1],[0,"Our pleasure!","Mums malonu!","beef3d190b73",0.81],[0,"Can I get you anything else?","Gal dar ko nors?","b4c284fdd203",1.29],[-1,"I have work tomorrow.","Rytoj dirbu.",1],[0,"Of course. We're so glad you came!","Žinoma. Taip džiaugiamės, kad atėjai!","c4157095576a",2.52],[-1,"That would be great, thanks.","Būtų puiku, ačiū.",1],[0,"Anytime! Come again soon!","Visada prašom! Užsuk vėl greitai!","611e501dca8a",2.04],[1,"Good night! Get home safe!","Labos nakties! Saugiai pareik!","97467ee12fc0",1.82],[0,"Hey! You made it! Come on in!","Labas! Atvykai! Užeik!","3dea7fa5b5b7",2.59],[1,"Hello! We're so happy you're here!","Labas! Taip džiaugiamės, kad atėjai!","8ae4f387aa91",2.71],[-2,"I brought you dessert.","Atnešiau jums desertą.",1],[1,"Dessert? You're the best!","Desertas? Tu geriausia!","5c716fe6f47f",1.94],[0,"Let me take your jacket.","Leisk paimti tavo striukę.","9f1e407cc0ba",1],[-1,"I brought you some cookies.","Atnešiau jums sausainių.",1],[0,"Can I get you something to drink? We have wine, beer, lemonade, or water.","Gal ko nors atsigerti? Turime vyno, alaus, limonado ar vandens.","a6a5c1a760f2",4.8],[-1,"I'll have a soda, thanks.","Imsiu gazuotą gėrimą, ačiū.",1],[0,"Coming right up!","Tuoj bus!","f586253a59f8",0.96],[1,"Dinner's almost ready. Make yourself at home!","Vakarienė beveik paruošta. Jauskis kaip namie!","064a98270366",2.45],[-2,"Can I help with anything?","Ar galiu kuo nors padėti?",1],[1,"No, no, just relax!","Ne, ne, tiesiog atsipalaiduok!","fb726ff37ce3",2.49],[-1,"Can I have the water, please?","Ar galiu gauti vandenį?",1],[0,"Sure! Here's the water.","Žinoma! Štai vanduo.","0d761d4f13c8",1.74],[1,"How's the lasagna?","Na, kaip lazanija?","922bd37360b0",1.4],[-2,"This is delicious!","Labai skanu!",1],[1,"Aw, I'm so glad you like it!","Oi, taip džiaugiuosi, kad patinka!","4a0388a743b0",2.2],[1,"There's plenty! More?","Yra daug! Įdėti dar?","d0e25111231c",2.14],[-2,"I'm full, thanks. It was delicious!","Esu soti, ačiū. Buvo labai skanu!",1],[1,"Okay! Save room for dessert!","Gerai! Palik vietos desertui!","e30f7d0d8cec",1.82],[1,"Thank you! Have some more!","Ačiū! Imk daugiau!","11266e089f11",2.01],[-2,"Yes, I'd love some!","Taip, labai norėčiau!",1],[1,"Here you go!","Prašom!","fbb533607b33",0.82],[0,"Wow, it's already almost eleven!","Oho, jau beveik vienuolikta!","bb1d34457829",2.37],[0,"Of course! Thanks so much for coming!","Žinoma! Labai ačiū, kad atėjai!","1e46c30da172",2.35],[-1,"Thanks for your help!","Ačiū už pagalbą!",1],[-2,"I brought you a pie.","Atnešiau jums pyragą.",1],[-1,"I brought you some flowers.","Atnešiau jums gėlių.",1],[0,"Oh, I forgot to ask: is there anything you don't eat?","O, pamiršau paklausti: ar yra kas nors, ko nevalgai?","7362deccce2e",3.85],[-1,"No, I eat everything!","Ne, valgau viską!",1],[0,"Great!","Puiku!","2147d8076a8c",0.78],[-1,"Just some white wine, please.","Tik baltojo vyno, prašau.",1],[0,"Okay, everyone, dinner's ready! Help yourself!","Gerai, visi, vakarienė paruošta! Vaišinkis!","e5eca109f84e",3.13],[-1,"Can I have the pepper, please?","Ar galiu gauti pipirus?",1],[0,"Here you go!","Prašom!","c534d8c7004b",0.81],[1,"So... do you like it?","Tai... ar patinka?","27f9e193a8f4",1.8],[-2,"You're a great cook!","Tu puiki virėja!",1],[-1,"It's getting late.","Jau vėlu.",1],[-1,"Not bad, thanks. How are you?","Neblogai, ačiū. Kaip tau sekasi?",1],[1,"Get home safe!","Saugiai pareik namo!","38002c1b1413",1.14],[1,"Not bad, thanks! How are you?","Neblogai, ačiū! Kaip tau sekasi?","5a36e00e181c",2.07],[-2,"Thank you for inviting me!","Ačiū, kad mane pakvietėte!",1],[0,"Of course! We're so glad you're here.","Žinoma! Taip džiaugiamės, kad atėjai.","baf7bf9b3642",2.5],[-1,"These are for you.","Čia jums.",1],[1,"Oh, thank you! You shouldn't have!","O, ačiū! Nereikėjo!","a1a6e9ff8ed7",3.17],[-1,"I think a tea would be great.","Manau, arbata būtų puiku.",1],[-2,"Something smells amazing!","Kažkas nuostabiai kvepia!",1],[0,"Thanks! It's lasagna. Nora's recipe.","Ačiū! Tai lazanija – Noros receptas.","4fbfabf3ed5c",3.01],[-1,"Could you pass the water, please?","Ar galėtum paduoti vandenį?",1],[1,"Would you like some more?","Gal įdėti dar?","ab142415fcbf",1.13],[-2,"Goodbye!","Viso gero!",1],[-1,"Hi! How are you?","Labas! Kaip sekasi?",1],[1,"I'm good, thanks! And you?","Gerai, ačiū! O tau?","1f9083436cdc",1.57],[-1,"Just some sparkling water, please.","Tik gazuoto vandens, prašau.",1],[1,"Sure! Could you put the salad on the table?","Žinoma! Ar galėtum padėti salotas ant stalo?","999666aa375a",2.55],[-2,"Happy to help!","Mielai padėsiu!",1],[1,"Thanks! You're a star.","Ačiū! Tu šaunuolė.","0fc8a82c904d",1.8],[-1,"Mmm, so good!","Mmm, kaip skanu!",1],[0,"Aw, I'm so glad you like it!","Oi, taip džiaugiuosi, kad patinka!","c6ddadb86975",2.08],[-1,"I should get going.","Man jau reikėtų eiti.",1],[-1,"I'm good, thanks. And you?","Gerai, ačiū. O tau?",1],[1,"That's so sweet, but we're fine. Just relax!","Kaip miela, bet mums viskas gerai. Tiesiog atsipalaiduok!","295f37bfec28",3.29],[1,"Oh no, I think I burned the garlic bread!","O ne, atrodo, sudeginau česnakinę duoną!","e196674afef0",2.84],[-2,"It's still delicious!","Vis tiek labai skanu!",1],[1,"Aw, you're sweet.","Oi, koks tu miela.","6df811357a5f",1.71],[-2,"Mmm, so good!","Mmm, kaip skanu!",1],[-2,"I couldn't eat another bite!","Nebegalėčiau suvalgyti nė kąsnio!",1],[1,"No problem! More for Dan!","Jokių problemų! Danui liks daugiau!","e624718fc721",2.56],[-1,"Thanks for everything!","Ačiū už viską!",1],[0,"More coffee?","Dar kavos?","8f192ea775d6",0.7],[-1,"Have a nice day!","Geros dienos!",1],[-1,"Could you speak more slowly, please?","Ar galėtum kalbėti lėčiau?",1],[0,"Of course. I'll say it slowly.","Žinoma. Pasakysiu lėtai.","b4de0d230717",2.23],[-1,"Yes, please.","Taip, prašau.",1],[1,"Oh, you shouldn't have! They're beautiful!","O, nereikėjo! Jos nuostabios!","dcd08081a968",3.46],[-1,"Water, please.","Vandenį, prašau.",1],[-1,"No, I'm good, thanks.","Ne, man nereikia, ačiū.",1],[-2,"Just a little, please.","Tik truputį, prašau.",1],[1,"Just a little. Here you go.","Tik truputį. Prašom.","5ecf9d9063c5",1.81],[-1,"No, thanks.","Ne, ačiū.",1],[-1,"I think a coffee would be great.","Manau, kava būtų puiku.",1],[-1,"Thank you very much!","Labai ačiū!",1],[-1,"A beer, please.","Alų, prašau.",1],[-1,"Sure, thanks!","Žinoma, ačiū!",1],[0,"Ooh, nice! We'll open it with dinner.","O, šaunu! Atidarysime prie vakarienės.","aca6356d403f",2.7],[-1,"Pretty good, thanks!","Visai gerai, ačiū!",1],[-2,"I brought you some cookies.","Atnešiau jums sausainių.",1],[1,"Cookies! Oh, you're too kind.","Sausainiai! O, tu per maloni.","bf87879ab4da",2.96],[-1,"I brought you some chocolates.","Atnešiau jums saldainių.",1],[0,"So... do you like it?","Tai... ar patinka?","9792de86256b",2.07],[-1,"Thanks for having me!","Ačiū, kad pakvietėte!",1],[-1,"Good night!","Labos nakties!",1],[0,"Sure, I'll speak more slowly.","Žinoma, kalbėsiu lėčiau.","63bd2f895d87",2],[1,"Pretty good, thanks! And you?","Visai gerai, ačiū! O tau?","e08c8fdae70a",2.27],[-1,"Goodbye!","Viso gero!",1],[-1,"I think a soda would be great.","Manau, gazuotas gėrimas būtų puiku.",1]],"contexts":[{"sim":2,"visits":0,"seed":3},{"visits":0,"seed":1},{"visits":3,"seed":2},{"sim":0,"visits":0,"seed":1},{"visits":1,"seed":2},{"visits":3,"seed":1},{"sim":1,"visits":0,"seed":2},{"visits":2,"seed":1},{"visits":2,"seed":2},{"visits":1,"seed":1}],"replies":["gift/1/chocolates","gift/1/wine","drinks/0/juice","cat/0","compliments/1","table/0/salt","food/2","dessert/0","goodbye/1","leave/2","g_yesno/4","gift/1/dessert","gift/1/cookies","drinks/1/soda","help/0","table/1/water_jug","food/0","more/1","dessert/1","g_social/1","gift/1/pie","coat/2","diet/0","drinks/3/white_wine","table/1/pepper","leave/1","g_howareyou/3","door/0","coat/1","drinks/4/tea","co