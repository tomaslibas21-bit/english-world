31,20,32,33,34,35,36,37,18],"cast":[["dot","g_dot",1]],"turns":[[0,"Hi there! How can I help you?","Sveiki! Kuo galiu padėti?","122742ab0cf6",1.96],[-1,"Pump three.","Trečia kolonėlė.",1],[0,"How much would you like to put on it?","Už kiek norėtumėte įpilti?","6050a4623352",1.46],[-1,"Fill it up on pump three, please.","Pilną baką trečioje kolonėlėje, prašau.",1],[0,"Sure. Are you paying with cash or card?","Žinoma. Mokėsite grynaisiais ar kortele?","9eee3ca84c7d",2.47],[-1,"Can I pay by card?","Ar galiu sumokėti kortele?",1],[0,"Okay. I'll put a hold on your card, and you'll pay only for what you pump.","Gerai. Užblokuosiu sumą Jūsų kortelėje, o sumokėsite tik už tiek, kiek įsipilsite.","b6906e61d594",4.33],[0,"Go ahead and tap your card.","Prašom pridėti kortelę.","9d83e4973bf9",1.4],[-1,"Can I get a receipt?","Ar galiu gauti čekį?",1],[0,"Here's your receipt.","Štai Jūsų čekis.","c5bf9f742322",0.82],[0,"Okay, pump three is ready. Just pick your grade at the pump.","Gerai, kolonėlė Nr. 3 paruošta. Degalų rūšį pasirinkite prie kolonėlės.","60b45d978d16",3.43],[-1,"Have a nice day!","Geros dienos!",1],[0,"See you!","Iki!","77937490fc6f",0.61],[0,"Morning! What pump are you on?","Labas rytas! Prie kurios kolonėlės stovite?","c0ba82535d58",1.75],[-1,"Forty dollars on pump three, please.","Keturiasdešimt dolerių į trečią kolonėlę, prašau.",1],[0,"Okay, that's forty dollars.","Gerai, iš viso 40 $.","fc583a834cb0",2.88],[-1,"I'll pay in cash.","Sumokėsiu grynaisiais.",1],[0,"Thanks! And here's your change.","Ačiū! Štai Jūsų grąža.","382343a57638",2.42],[0,"You're all set! Pump three is on.","Viskas! Kolonėlė Nr. 3 įjungta.","b195c083855c",2],[-1,"Hi! How are you?","Sveiki! Kaip sekasi?",1],[0,"I'm good, thanks! And you?","Gerai, ačiū! O Jums?","5818793ccd15",1.73],[-1,"Fine, thank you. And you?","Gerai, ačiū. O Jums?",1],[0,"I'm great, thanks for asking!","Puikiai, ačiū, kad klausiate!","72b835778297",1.99],[0,"Hey, you're back! Everything okay?","Ei, Jūs grįžote! Viskas gerai?","d598e5d49baa",2.45],[-1,"Could you call roadside assistance?","Ar galėtumėte iškviesti techninę pagalbą kelyje?",1],[0,"Sure, hon, I'll call them right now. They usually get here in about thirty minutes.","Žinoma, mielasis, tuoj paskambinsiu. Jie paprastai atvyksta per maždaug pusvalandį.","c63dcb177d42",4.73],[0,"Have a good one!","Geros dienos!","bae282965c20",0.97],[0,"Hi, hon! What can I do for you?","Sveiki, mielasis! Kuo galiu padėti?","0fee7a052f06",1.97],[-1,"I'd like to put twenty dollars on pump two.","Norėčiau įpilti už dvidešimt dolerių antroje kolonėlėje.",1],[0,"Okay, that's twenty dollars.","Gerai, iš viso 20 $.","0bed46584e9f",2.66],[0,"Cash or card?","Grynaisiais ar kortele?","5c042426a058",0.89],[-1,"Here you go.","Prašom.",1],[0,"Okay, pump two is ready. Just pick your grade at the pump.","Gerai, kolonėlė Nr. 2 paruošta. Degalų rūšį pasirinkite prie kolonėlės.","a51b38d10d4d",3.22],[-1,"Thanks for your help!","Ačiū už pagalbą!",1],[0,"You're welcome!","Prašom!","7ab684911dc3",1.09],[0,"Anything else I can do for you?","Ar dar kuo nors galiu padėti?","2cb9cf0d5ef0",1.57],[-1,"No, that's all. Thanks!","Ne, tai viskas. Ačiū!",1],[0,"Drive safe, hon!","Saugaus kelio, mielasis!","a36b8cee8529",1.19],[0,"That'll be forty dollars.","Iš viso 40 $.","625cdc471f83",1.8],[-1,"Can I use the restroom?","Ar galiu pasinaudoti tualetu?",1],[0,"Sure, here's the key. It's around the side of the building.","Žinoma, štai raktas. Tualetas – už pastato kampo.","00d8b0ca8185",3.17],[-1,"My car won't start.","Mano automobilis neužsiveda.",1],[0,"Oh no! There's a mechanic two blocks down, or I can call roadside assistance for you.","O ne! Už dviejų kvartalų yra autoservisas, arba galiu Jums iškviesti techninę pagalbą kelyje.","2e3cbe9638fc",6.14],[-1,"Is there a mechanic nearby?","Ar netoliese yra autoservisas?",1],[0,"Sure, Mike's Auto Repair is just two blocks down on the left.","Žinoma, „Mike's Auto Repair“ – vos už dviejų kvartalų, kairėje.","e6791b274c55",3.43],[0,"Thanks, hon.","Ačiū, mielasis.","838e2a2b1c40",0.75],[0,"Thanks, and have a great trip!","Ačiū ir geros kelionės!","8f4ad217524a",2],[-1,"I'm on pump five.","Esu prie penktos kolonėlės.",1],[0,"That'll be twenty dollars.","Iš viso 20 $.","9c2463042925",1.69],[-1,"Cash, please.","Grynaisiais, prašau.",1],[0,"Do you want a receipt?","Ar reikia čekio?","3b0174ab6de1",0.98],[-1,"No, I'm good, thanks.","Ne, man nereikia, ačiū.",1],[0,"No problem.","Jokių problemų.","16dfa227b331",1.17],[0,"You're all set! Pump two is on.","Viskas! Kolonėlė Nr. 2 įjungta.","2cf8dc656ff0",2.05],[0,"Pretty good, thanks! And you?","Visai gerai, ačiū! O Jums?","a9dcff2735bd",2.26],[-1,"Sorry, I don't understand.","Atsiprašau, nesuprantu.",1],[0,"No problem. I'll say it again, more slowly.","Jokių problemų. Pakartosiu lėčiau.","9ac89c66f47e",2.98],[-1,"Great, thanks for asking!","Puikiai, ačiū, kad klausiate!",1],[0,"Good to hear!","Gera girdėti!","c859ccecbc94",0.75],[0,"Oh, sorry, pump three is out of order today. Could you use pump five?","O, atsiprašau, kolonėlė Nr. 3 šiandien neveikia. Ar galėtumėte naudotis kolonėle Nr. 5?","413d2dc54bf2",4.55],[-1,"Sure, no problem.","Žinoma, jokių problemų.",1],[-1,"Card, please.","Kortele, prašau.",1],[0,"Receipt?","Čekio?","2ee880625df7",0.82],[-1,"No, thanks.","Ne, ačiū.",1],[0,"You're all set! Pump five is on.","Viskas! Kolonėlė Nr. 5 įjungta.","c3a66acba799",2.03],[-1,"Which one is diesel?","Kuris dyzelinas?",1],[0,"Diesel is the green handle, on pumps seven and eight.","Dyzelinas – žalias pistoletas, septintoje ir aštuntoje kolonėlėse.","a392bb40481a",3.96],[-1,"Thank you very much!","Labai ačiū!",1],[0,"Anytime!","Visada prašom!","52e4ab958893",1.34],[-1,"Yes, please.","Taip, prašau.",1],[0,"Great! Drive safe!","Puiku! Saugaus kelio!","79a46c6374b8",1.27],[0,"Not bad, thanks! How are you?","Neblogai, ačiū! Kaip Jums sekasi?","dae93bef73d4",1.79],[0,"Pretty good, thanks!","Visai gerai, ačiū!","a63040f877e6",1.67],[-1,"Goodbye!","Viso gero!",1],[0,"Bye! Have a great day!","Iki! Puikios dienos!","3e41c8b5b7de",1.45],[-1,"Could I have the restroom key?","Ar galėčiau gauti tualeto raktą?",1],[-1,"How do I get to the highway?","Kaip nuvažiuoti iki greitkelio?",1],[0,"Take a right out of here, go straight through two lights, and follow the signs for ninety-five North.","Išvažiavę pasukite dešinėn, važiuokite tiesiai per dvi sankryžas su šviesoforais ir sekite ženklus į 95-ąjį greitkelį šiaurės kryptimi.","63e11d299680",5.74],[0,"How much do you want?","Kiek norite?","a0c3ef69bc47",1.24],[0,"Anything else for you today?","Ar dar ko nors šiandien?","93a0d2101751",1.45],[-1,"Where can I put air in my tires?","Kur galiu pripūsti padangas?",1],[0,"The air machine is around the back. It's a dollar fifty.","Oro pripūtimo aparatas – už pastato. Kainuoja dolerį penkiasdešimt.","66a6263c9c0b",2.98],[-1,"That would be great, thanks.","Būtų puiku, ačiū.",1],[-1,"Pretty good, thanks!","Visai gerai, ačiū!",1],[0,"Glad to hear it!","Smagu girdėti!","378a6ea28d1d",0.96],[0,"Good, thank you!","Gerai, ačiū!","621517acf33c",1.01],[0,"No problem!","Nėra už ką!","0bdf90d6b1fa",1.25],[0,"Anything else? Coffee, snacks?","Dar ko nors? Kavos, užkandžių?","0b84610bdc86",3.08],[0,"Take care!","Laikykitės!","25bd21ac702c",0.76],[0,"My pleasure!","Mielai!","b859b40f4c3e",1.31],[0,"Goodbye! Have a nice day!","Viso gero! Geros dienos!","8f3832a09f06",1.87],[0,"Okay, pump five is ready. Just pick your grade at the pump.","Gerai, kolonėlė Nr. 5 paruošta. Degalų rūšį pasirinkite prie kolonėlės.","39398ed939e8",3.45],[0,"Nice!","Puiku!","fa7bc8cd2ba1",1.35]],"contexts":[{"sim":1,"visits":0,"seed":2},{"visits":3,"seed":1},{"sim":2,"visits":0,"seed":3},{"visits":3,"seed":2},{"sim":4,"visits":0,"seed":5},{"visits":2,"seed":1},{"sim":6,"visits":0,"seed":7},{"visits":2,"seed":2},{"visits":1,"seed":2},{"visits":0,"seed":2},{"sim":3,"visits":0,"seed":4},{"sim":0,"visits":0,"seed":1},{"visits":0,"seed":1}],"replies":["prepay/2","prepay/1","pay/2"