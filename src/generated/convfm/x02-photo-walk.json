","375518e7d576",1.65],[-1,"Sure, I'd love to!","Žinoma, mielai!",1],[0,"Oh, thank you! Here's my list.","O, ačiū! Štai mano sąrašas.","f548eccdbb83",2.36],[0,"Find each thing, take a photo and tell me what it is.","Suraskite kiekvieną dalyką, nufotografuokite ir pasakykite man, kas tai.","43a059e7ec6f",3.71],[0,"Have fun!","Smagaus pasivaikščiojimo!","dca6c67a23ed",1.03],[0,"Hi again! Do you have time for my photo book now?","Sveiki dar kartą! Gal dabar turite laiko mano nuotraukų knygai?","7706f35094ce",3.54],[-1,"Sorry, I don't understand.","Atsiprašau, nesuprantu.",1],[0,"No problem. I'll say it again, more slowly.","Jokių problemų. Pakartosiu lėčiau.","d3d17ac31493",3.03],[-1,"Yes, please.","Taip, prašau.",1],[-1,"What does that mean?","Ką tai reiškia?",1],[0,"Good question! Let me show you.","Geras klausimas! Tuoj parodysiu.","8729d727008a",2.24],[-1,"That would be great, thanks.","Būtų puiku, ačiū.",1],[-1,"Could you speak more slowly, please?","Ar galėtumėte kalbėti lėčiau?",1],[0,"Of course. I'll say it slowly.","Žinoma. Pasakysiu lėtai.","e5c27ab89e12",2.29],[-1,"Sure! What do I do?","Žinoma! Ką man daryti?",1],[-1,"Thanks for your help!","Ačiū už pagalbą!",1],[0,"You're welcome!","Prašom!","11c0ee7c1cbb",1.32],[-1,"Sure, thanks!","Žinoma, ačiū!",1],[-1,"Sorry, could you say that again?","Atsiprašau, ar galėtumėte pakartoti?",1],[-1,"Could you repeat that, please?","Ar galėtumėte pakartoti?",1],[-1,"Sorry, I didn't catch that.","Atsiprašau, nenugirdau.",1],[-1,"Thank you very much!","Labai ačiū!",1],[0,"My pleasure!","Mielai!","f0d0bad0c8a0",1.36],[0,"Here, let me explain.","Tuoj paaiškinsiu.","546fe4eafa18",1.44],[0,"Sure, I'll speak more slowly.","Žinoma, kalbėsiu lėčiau.","2e23b9e8ceb8",1.94],[0,"Anytime!","Visada prašom!","ce64dcdeaf79",1.04],[0,"No problem!","Nėra už ką!","64453b0fa91f",1.2]],"contexts":[{"sim":0,"visits":0,"seed":1},{"visits":1,"seed":1},{"visits":0,"seed":1},{"visits":0,"seed":2}],"replies":["help/0","g_clarify/4","g_yesno/0","g_cla